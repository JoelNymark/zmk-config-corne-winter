#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &kp TAB    &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &mo 2
                &kp ESC    &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
                &kp LSHFT  &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp RET
                            &kp LALT &kp LCTRL &kp BSPC   &kp SPACE &kp LGUI &mo 1
                        >;
        };
            lower_layer {
            display-name = "Lower";
            bindings = <
                &kp TAB    &kp N1       &kp N2      &kp N3       &kp N4    &kp N5             &kp N6   &kp N7   &kp N8    &kp N9    &kp N0 &kp BSPC
                &trans     &kp C_VOL_DN &kp C_MUTE  &kp C_VOL_UP &trans    &trans             &trans   &trans   &trans    &kp UP    &trans &trans
                &kp LSHFT  &kp C_NEXT   &kp C_PP    &kp C_PREV   &trans    &trans             &trans   &trans   &kp LEFT  &kp DOWN  &kp RIGHT &trans
                                                    &kp LGUI     &kp DEL   &trans             &kp RET  &trans   &kp RALT
                        >;
        };

            raise_layer {
            display-name = "Raise";
            bindings = <
                &kp  TAB  &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
                &kp LCTRL &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp GRAVE
                &kp LSHFT &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE &kp TILDE
                                          &kp LGUI &mo 3 &trans         &kp RET   &trans    &to 4
                        >;
        };

            adjust_layer {
            display-name = "Adj";
            bindings = <
                &kp F1 &kp F2  &kp F3 &kp F4 &kp F5 &kp F6   &kp F7 &kp F8  &kp F9 &kp F10 &kp F11 &kp F12
                &trans &trans  &trans &trans &trans &trans   &trans &trans  &trans &trans &trans &trans
                &trans &trans  &trans &trans &trans &trans   &trans &trans  &trans &trans &trans &trans
                                      &trans &trans &trans   &trans &trans  &trans
                        >;
        };
            gaming_layer {
            display-name = "Game";
            bindings = <
                &kp  TAB  &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &none
                &kp ESC    &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
                &kp LSHFT  &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp RET
                            &kp LALT &kp LCTRL &kp SPACE   &to 0 &kp LGUI &none
                        >;
            };
    };
};