#include "corne_winter.dtsi"

/ {
    /* Mock kscan for dongle */
    kscan_dongle: kscan_dongle {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    /* 👇 THIS is required for ZMK display */
    chosen {
        zmk,display = &oled;
    };
};

/* Replace kscan */
&physical_layout_corne_winter {
    kscan = <&kscan_dongle>;
};

/* 👇 Enable I2C + define OLED */
&i2c0 {
    status = "okay";

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        label = "OLED";

        width = <128>;
        height = <32>; /* change to 64 if needed */
    };
};