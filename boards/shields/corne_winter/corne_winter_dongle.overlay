#include "corne_winter.dtsi"

/ {
    /* Mock kscan for dongle */
    kscan_dongle: kscan_dongle {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    /* 👇 THIS is required for ZMK display */
    chosen {
        zephyr,display = &oled;
    };
};

/* Replace kscan */
&physical_layout_corne_winter {
    kscan = <&kscan_dongle>;
};

/* I2C + SH1107 display */
&pro_micro_i2c {
    status = "okay";

    oled: sh1107@3c {
        compatible = "sinowealth,sh1107";
        reg = <0x3c>;

        width = <128>;
        height = <128>;

        /* 🔑 THESE MATTER */
        segment-offset = <0>;
        page-offset = <0>;

        /* 🔥 This is the magic for SH1107 */
        display-offset = <32>;

        multiplex-ratio = <127>;

        /* Stable power settings */
        prechargep = <0x22>;

        /* ⚠️ Do NOT rely on these (often ignored) */
        /* segment-remap; */
        /* com-invdir; */
    };
};
